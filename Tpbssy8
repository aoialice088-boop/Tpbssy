-- Encontra o TouchControlFrame (analógico virtual)
local function findTouchControl()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    -- Procura em vários lugares possíveis
    local candidates = {
        playerGui:FindFirstChild("TouchGui", true),
        playerGui:FindFirstChild("TouchControlFrame", true),
    }
    
    for _, candidate in ipairs(candidates) do
        if candidate then
            local thumbstick = candidate:FindFirstChild("DynamicThumbstickFrame", true) 
                or candidate:FindFirstChild("ThumbstickFrame", true)
                or candidate:FindFirstChild("Thumbstick", true)
            if thumbstick then
                return thumbstick
            end
        end
    end
    
    -- Busca recursiva
    for _, desc in pairs(playerGui:GetDescendants()) do
        local name = desc.Name
        if name == "DynamicThumbstickFrame" or name == "ThumbstickFrame" or name == "Thumbstick" then
            return desc
        end
    end
    
    return nil
end

-- Encontra o thumb (botão arrastável) dentro do thumbstick
local function findThumb(thumbstick)
    if not thumbstick then return nil end
    
    for _, child in pairs(thumbstick:GetDescendants()) do
        if child:IsA("ImageLabel") or child:IsA("Frame") or child:IsA("ImageButton") then
            local name = string.lower(child.Name)
            if string.find(name, "thumb") then
                return child
            end
        end
    end
    
    -- Se não achou pelo nome, pega o primeiro filho visual
    for _, child in pairs(thumbstick:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "ThumbstickFrame" then
            return child
        end
    end
    
    return nil
end

