    local startTime = tick()
    local timeout = 60 -- máximo 60 segundos
    
    while tick() - startTime < timeout do
        if not hrp or not hrp.Parent then break end
        
        local currentPos = hrp.Position
        local direction = targetPos - currentPos
        direction = Vector3.new(direction.X, 0, direction.Z) -- só plano horizontal
        local distance = direction.Magnitude
        
        -- Se chegou perto o suficiente, para
        if distance < arrivalThreshold then
            break
        end
        
        -- Normaliza a direção
        direction = direction.Unit
        
        -- Converte direção do mundo pra direção relativa à câmera
        local camera = workspace.CurrentCamera
        local camCF = camera.CFrame
        local camForward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
        local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
        
        -- Calcula input do analógico (X = direita/esquerda, Y = frente/trás)
        local inputX = direction:Dot(camRight)
        local inputY = -direction:Dot(camForward) -- inverte porque Y negativo = frente
        
        -- Normaliza pra não passar de 1
        local mag = math.sqrt(inputX * inputX + inputY * inputY)
        if mag > 1 then
            inputX = inputX / mag
            inputY = inputY / mag
        end
        
        -- Move o thumb pra simular o arrasto
