local function touchWalk(targetPos)
    if walkInProgress then
        statusLabel.Text = "⏳ Caminhada em andamento..."
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        return
    end
    
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    
    local thumbstick = findTouchControl()
    if not thumbstick then
        statusLabel.Text = "❌ Analógico não encontrado\nUsando Micro-Steps como fallback"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        teleportMicroSteps(targetPos)
        return
    end
    
    local thumb = findThumb(thumbstick)
    if not thumb then
        statusLabel.Text = "❌ Thumb não encontrado\nUsando Micro-Steps como fallback"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        teleportMicroSteps(targetPos)
        return
    end
    
    walkInProgress = true
    statusLabel.Text = "🚶 Caminhando até o destino..."
    statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    local targetSpeed = tonumber(speedInput.Text) or 16
    local arrivalThreshold = tonumber(stepInput.Text) or 0.5
    
    -- Guarda estado original
    local originalWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = targetSpeed
    
    -- Pega a posição original do thumb pra restaurar depois
    local originalThumbPos = thumb.Position
    
